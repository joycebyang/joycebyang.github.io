---
layout: default
---
<div class="post home">
  <header class="home-intro">
    {% if page.profile and page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      <div class="home-photo">
        {%
          include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="208px" alt=site.first_name
          cache_bust=true
        %}
      </div>
    {% endif %}
    <div>
      <h1 class="home-name">
        {%- if site.title == 'blank' -%}
          {{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}
        {%- else -%}
          {{ site.title }}
        {%- endif -%}
      </h1>
      {% if page.subtitle %}
        <p class="home-role">{{ page.subtitle }}</p>
      {% endif %}
    </div>
  </header>

  <article>
    <div class="home-bio">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 class="home-heading">News</h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2 class="home-heading">Latest posts</h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="home-heading">Publications</h2>
      <p class="pub-lead">* denotes equal contribution.</p>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Teaching (entries live in _data/teaching.yml) -->
    {% if site.data.teaching %}
      <h2 class="home-heading">Teaching</h2>
      <ul class="teaching-list">
        {% for t in site.data.teaching %}
          <li>
            <span class="teaching-term">{{ t.term }}</span>
            <div>
              <p class="teaching-course">{{ t.course }}</p>
              <p class="teaching-meta">
                {{ t.role }}{% if t.org %} · {{ t.org }}{% endif %}{% if t.instructor %} · Instructor: {{ t.instructor }}{% endif %}
              </p>
              {% if t.description %}
                <p class="teaching-desc">{{ t.description }}</p>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
