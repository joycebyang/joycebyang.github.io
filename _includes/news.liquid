{% comment %}
  News list. With limit=true (homepage), the first `announcements.limit` items are shown
  and the rest sit behind a "Show all news" toggle.
{% endcomment %}
<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% assign news_size = site.news | size %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}

    {% capture news_rows_shown %}
      {% for item in news limit: news_limit %}
        {% include news_item.liquid item=item %}
      {% endfor %}
    {% endcapture %}
    <ul class="news-list">{{ news_rows_shown }}</ul>

    {% if news_size > news_limit %}
      <details class="news-more">
        <summary>Show all news</summary>
        <ul class="news-list">
          {% for item in news offset: news_limit %}
            {% include news_item.liquid item=item %}
          {% endfor %}
        </ul>
      </details>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
